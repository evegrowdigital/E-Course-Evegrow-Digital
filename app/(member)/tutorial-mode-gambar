
import { getItems } from '@/lib/konten.js';

export const dynamic = 'force-dynamic';

export default async function TutorialModeGambarPage() {
  const items = await getItems('tutorial-mode-gambar');

  return (
    <main className="text-white">
      <h1 className="mb-5 text-2xl font-bold">Tutorial Mode Gambar</h1>

      {items.length === 0 ? (
        <p className="text-sm text-purple-200/60">Belum ada tutorial tersedia.</p>
      ) : (
        <div className="grid grid-cols-2 gap-3 md:grid-cols-3 lg:grid-cols-4">
          {items.map((item) => (
            <article
              key={item.id}
              className="overflow-hidden rounded-2xl border border-purple-400/20 bg-white/5"
            >
              {item.cover && (
                <div className="aspect-video overflow-hidden">
                  <img
                    src={item.cover}
                    alt={item.judul || 'Cover tutorial'}
                    className="h-full w-full object-cover"
                  />
                </div>
              )}

              <div className="p-3">
                <h2 className="text-sm font-semibold sm:text-base">
                  {item.judul}
                </h2>
                {item.deskripsi && (
                  <p className="mt-1 text-xs text-purple-200/70">
                    {item.deskripsi}
                  </p>
                )}
              </div>
            </article>
          ))}
        </div>
      )}
    </main>
  );
}
